# ============================================================================
# ISKCON SHIRPUR DMS & CRM — ENVIRONMENT CONFIGURATION
# ============================================================================

PORT=5000
NODE_ENV=production
APP_URL="https://your-app.onrender.com"
TIMEZONE="Asia/Kolkata"
CRON_SECRET="your-secure-cron-refresh-token"

# ----------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION (PostgreSQL)
# ----------------------------------------------------------------------------
# From Supabase Dashboard -> Project Settings -> Database:
# Connection Pooling URL (Transaction Pooler - Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection URL (Session / Direct - Port 5432) for Prisma Migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase Public URL and Anon Key (if using Supabase Auth or Storage)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ----------------------------------------------------------------------------
# 2. AUTHENTICATION (JWT)
# ----------------------------------------------------------------------------
AUTH_SECRET="iskcon-shirpur-super-secret-jwt-key-change-in-production"

# ----------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API (Official WhatsApp Business API)
# ----------------------------------------------------------------------------
# From Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup:
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN="iskcon_shirpur_verify_token_2026"
META_API_VERSION="v20.0"

# WhatsApp Template Names (created in WhatsApp Business Manager)
META_BIRTHDAY_TEMPLATE="iskcon_birthday_blessing_hi"
META_RECEIPT_TEMPLATE="iskcon_seva_receipt_hi"

# Mode: 'production' to send live messages, 'mock' to simulate sends locally
WHATSAPP_MODE="mock"

# ----------------------------------------------------------------------------
# 4. OPTIONAL AI WISH GENERATOR (Google Gemini API)
# ----------------------------------------------------------------------------
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# ----------------------------------------------------------------------------
# 5. LEGACY / SMS FALLBACK PROVIDER
# ----------------------------------------------------------------------------
SMS_PROVIDER="dummy"
SMS_API_KEY=""
SMS_SENDER_ID=""
